# Copy to .env.local and fill in. Both values are baked in at build time, so rebuild after changing them.

# Formspree form endpoint for the contact form. Until it's a real form ID, the form stays disabled.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID

# Calendly scheduling link for the "Book an intro call" buttons, e.g.
# https://calendly.com/your-name/intro-call
# Leave unset and those buttons point at the contact form instead.
NEXT_PUBLIC_CALENDLY_URL=
