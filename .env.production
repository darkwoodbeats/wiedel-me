# Production build values, committed on purpose. The deploy build runs on GitHub Actions, which has
# no .env.local; without this file it bakes in the fallbacks (contact form disabled, booking buttons
# pointing at the form). Both values are public anyway: they ship in the page's JavaScript.
# For `next dev`, .env.local still applies (copy .env.example).

# Formspree form endpoint for the contact form.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/mljebdpy

# Calendly scheduling link for the "Book an intro call" buttons ("30 Minute Meeting" event).
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/cbwiedel/30min
