# Production build values, committed on purpose. The deploy build runs on GitHub Actions, which has
# no .env.local; without this file it bakes in the placeholder, and the contact form ships disabled.
# The value is public anyway: it ships in the page's JavaScript. `next dev` still reads .env.local.

# Formspree form endpoint for the contact form.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/mljebdpy

# NEXT_PUBLIC_CALENDLY_URL is left unset, so the "Book a call" buttons point at the form.
