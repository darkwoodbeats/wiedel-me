# Production build values, committed on purpose. The deploy build runs on GitHub Actions, which has
# no .env.local; without this file it bakes in the fallbacks: the contact form ships disabled and the
# "Book a call" buttons point at the form. Both values are public anyway: they ship in the page.
# `next dev` still reads .env.local.

# Formspree form endpoint for the contact form.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/mljebdpy

# Calendly scheduling link for the "Book a call" buttons ("30 Minute Meeting" event).
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/cbwiedel/30min
