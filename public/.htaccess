# Static Next.js export on Apache (cPanel / A Small Orange).

# --- Compression ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# HEAD requests go out uncompressed. Over HTTP/2 this host sends a malformed reply to a compressed
# HEAD (Chrome logs ERR_CONTENT_DECODING_FAILED), and Next's router sends a HEAD before prefetching
# a route. A HEAD has no body, so nothing is lost.
<IfModule mod_setenvif.c>
  SetEnvIfNoCase Request_Method "^HEAD$" no-gzip
</IfModule>

# --- Caching ----------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  # Hashed build assets are immutable — cache them hard.
  <FilesMatch "\.(js|css|woff2)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, immutable"
  </FilesMatch>
  # Images change when a client redesigns; a month is a reasonable compromise.
  <FilesMatch "\.(jpg|jpeg|png|svg|webp|avif|ico)$">
    ExpiresDefault "access plus 1 month"
  </FilesMatch>
  # HTML must revalidate so a redeploy is picked up immediately.
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Force HTTPS ------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# --- Custom 404 -------------------------------------------------------------
ErrorDocument 404 /404.html

# Next's export writes directory-style URLs; let Apache serve their index.html.
DirectoryIndex index.html
